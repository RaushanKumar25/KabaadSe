datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model City {
  id        String      @id @default(uuid())
  name      String      @unique
  slug      String      @unique
  isActive  Boolean     @default(true)
  rates     ScrapRate[]
  createdAt DateTime    @default(now())
}

model ScrapItem {
  id        String      @id @default(uuid())
  name      String
  category  String
  unit      String      // "kg" | "pcs"
  iconPath  String      // e.g. "/images/ScrapImages/E-waste.png"
  rates     ScrapRate[]
  createdAt DateTime    @default(now())
}

model ScrapRate {
  id        String    @id @default(uuid())
  cityId    String
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  itemId    String
  item      ScrapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price     Float
  updatedAt DateTime  @updatedAt

  @@unique([cityId, itemId])
}

model PickupRequest {
  id             String   @id @default(uuid())
  customerName   String
  customerPhone  String
  city           String
  locality       String
  address        String
  pickupDate     DateTime
  estimatedLoad  String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
}